{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcalibrate/upcoming-events",
	"version": "1.0.0",
	"title": "WPCalibrate Upcoming Events",
	"category": "widgets",
	"icon": "clock",
	"description": "Display a responsive list of upcoming events.",
	"keywords": [ "upcoming", "events", "list", "wpcalibrate" ],
	"attributes": {
		"limit": {
			"type": "number",
			"default": 5
		},
		"category": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "wpcalibrate-events-manager",
	"editorScript": "wpcal-blocks-js",
	"style": "wpcal-calendar-css"
}
